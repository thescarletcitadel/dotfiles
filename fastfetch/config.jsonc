{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
    },
    "size": {
      "binaryPrefix": "jedec"
    },
    "separator": " "
  },
  "logo": {
    "type": "auto",
    "source": "/home/crimson/.config/fastfetch/my-logo.txt",
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "os",
      "keyColor": "yellow",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "ker",
      "keyColor": "green"
    },
        {
      "type": "shell",
      "key": "sh",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "up",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "red",
      "format": "{name}"
    },
    "gpu",
    {
      "type": "memory",
      "key": "ram",
      "keyColor": "yellow",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "cyan",
      "folders": [
        "/"
      ],
      "format": "{size-used} / {size-total}"
    },
    "break",
    
  ]
}

