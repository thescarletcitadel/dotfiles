[global]
    ### Display and Layout ###
    monitor = 0
    follow = mouse
    
    # Position on screen (top_right, top_left, bottom_right, etc.)
    origin = top-right
    offset = 20x20
    
    # Dimensions
    width = 350
    height = 150
    notification_limit = 5
    
    # Progress bar (for volume/brightness sliders)
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    ### Styling ###
    # Rounded corners (requires a compositor like picom)
    corner_radius = 8
    
    # Border
    frame_width = 2
    separator_height = 2
    
    # Fonts and Text
    font = JetBrains Mono 10
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    
    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

    ### History & Control ###
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    
    # Mouse bindings
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# --- Theme & Colors ---

[urgency_low]
    # Subtle dark gray background, green accents for "all good"
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#a6e3a1"
    timeout = 4

[urgency_normal]
    # Standard dark theme, lavender/blue accent
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 8

[urgency_critical]
    # Dark background, bright red accent for alerts
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0 # stays on screen until dismissed
