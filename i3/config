# apps to install to get the best out of this config
# window colorswindow colors
set $border #FF0000

client.focused $border $border $border $border
client.focused_inactive $border $border $border $border
client.unfocused $border $border $border $border
client.urgent $border $border $border $border

#pops open the world clock gui
bindcode 191 exec $HOME/.config/polybar/worldclock.sh
#turn down media
bindcode 192 exec $HOME/dotfiles/mediadown.sh
#turn up media
bindcode 193 exec $HOME/dotfiles/mediaup.sh
#turn up fluxer
bindsym F24 exec $HOME/dotfiles/fluxerup.sh
#turn down fluxer
bindsym F23 exec $HOME/dotfiles/fluxerdown.sh



bindsym Menu exec rofi -config ~/.config/rofi/app-grid.rasi -show drun

#set i3 font
font pango:JetBrainsMono Nerd Font Mono 11

#set window gaps 
set $gaps 8
#set border width 
default_border pixel 5
gaps outer $gaps
gaps inner $gaps

#set super key as the modifier key
set $mod Mod4

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
#exec --no-startup-id dex --autostart --environment i3

# lock the system to reinput your password
bindsym $mod+shift+i exec --no-startup-id i3lock -c 000000

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR5 i3status
# raises computer volume
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
# lowers volume
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3status
#mutes sounds
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
# mutes the mic
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
#play media
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
#pause media
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
#media next
bindsym XF86AudioNext exec --no-startup-id playerctl next
#media previous
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
#media stop
bindsym XF86AudioStop exec --no-startup-id playerctl stop

# switches audio to preset sources
bindsym $mod+F1 exec $HOME/dotfiles/.audioswap.sh
# focus pip videos
bindsym $mod+shift+p exec wmctrl -a "picture-in-picture"; exec --no-startup-id $HOME/.config/i3/centermouse.sh
# takes a screenshot of selected region 
bindsym $mod+shift+s exec $HOME/dotfiles/screenshot selection
# open color picker 
bindsym $mod+control+s exec $HOME/dotfiles/screenshot color
# takes a screenshot of the current window and opens it 
bindsym $mod+s exec $HOME/dotfiles/screenshot window 
# open bc in topbar
bindsym $mod+shift+plus exec notify-send $(dmenu -p "calc" <&- | bc -l 2>/dev/null)

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod
# Load the layout onto the current workspace
bindsym $mod+shift+u exec i3-resurrect restore -w firefox
# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.

# applications
#open fluxer
bindsym $mod+ctrl+g exec $HOME/pkg/fluxer.AppImage
#focus fluxer
bindsym $mod+ctrl+shift+g exec wmctrl -a "fluxer"; exec --no-startup-id $HOME/.config/i3/centermouse.sh
#open vencord
bindsym $mod+g exec $HOME/pkg/vencord.AppImage
#focus vencord
bindsym $mod+shift+g exec wmctrl -a "discord"; exec --no-startup-id $HOME/.config/i3/centermouse.sh
#starts recording in obs
bindsym $mod+o exec obs --startrecording
#opens xkill to kill programs
bindsym $mod+shift+x exec xkill
#opens xprop
bindsym $mod+x exec kitty --hold xprop
#opens notes launcher
bindsym $mod+n exec $HOME/.config/i3/notes.sh
#opens private notes
bindsym $mod+shift+n exec $HOME/.config/i3/jan.sh
#opens veracrypt
bindsym $mod+v exec veracrypt
#focus veracrypt
bindsym $mod+shift+v exec wmctrl -a "veracrypt"; exec --no-startup-id $HOME/.config/i3/centermouse.sh
#open the icon picker
bindsym $mod+comma exec rofi nerdy -show nerdy
#opens btop in terminal workspace
bindsym $mod+ctrl+Return exec $HOME/.config/i3/.btop.sh
#opens a fresh terminal
bindsym $mod+Return exec kitty --title ck1
# opens main browser
bindsym $mod+b exec $HOME/pkg/zen.AppImage
# focus the main browser
bindsym $mod+shift+b exec wmctrl -a "zen"; exec --no-startup-id $HOME/.config/i3/centermouse.sh
# focuses main terminal window
bindsym $mod+shift+Return exec wmctrl -a "ck1"; exec --no-startup-id $HOME/.config/i3/centermouse.sh
# opens the shortcut list
bindsym $mod+shift+o exec $HOME/dotfiles/i3/i3key.sh
# opens a window switcher
bindsym Mod1+Tab exec rofi -show window
# opens localsend 
bindsym $mod+t exec $HOME/pkg/localsend.AppImage
#focus local send
bindsym $mod+shift+t exec wmctrl -a "localsend"; exec --no-startup-id $HOME/.config/i3/centermouse.sh
# opens wallpaper changer
bindsym $mod+w exec $HOME/.config/i3/wallpaper.sh
#opens my Ai
bindsym $mod+a exec $HOME/dotfiles/secondai.sh
#opens secondai
bindsym $mod+ctrl+a exec $HOME/dotfiles/lumo.sh
#opens authenticator
bindsym $mod+e exec $HOME/pkg/ente-auth.AppImage
#focus authenticator
bindsym $mod+shift+e exec wmctrl -a "Ente Auth"; exec --no-startup-id $HOME/.config/i3/centermouse.sh
#focus ai 
bindsym $mod+shift+a exec wmctrl -a "gemini"; exec --no-startup-id $HOME/.config/i3/centermouse.sh
#focus second ai
bindsym $mod+shift+ctrl+a exec wmctrl -a "lumo"; exec --no-startup-id $HOME/.config/i3/centermouse.sh

# moving mouse with the keyboard super and alt 
# moves mouse to the left
bindsym $mod+Mod1+h exec xdotool mousemove_relative -p 270 10
# move mouse to the right
bindsym $mod+Mod1+l exec xdotool mousemove_relative -p 90 10
# move mouse up
bindsym $mod+Mod1+k exec xdotool mousemove_relative -p 0 10
# move mouse down
bindsym $mod+Mod1+j exec xdotool mousemove_relative -p 180 10
# fast move mouse left
bindsym $mod+ctrl+Mod1+h exec xdotool mousemove_relative -p 270 100
# fast move mouse to right
bindsym $mod+ctrl+Mod1+l exec xdotool mousemove_relative -p 90 100
# fast move mouse up
bindsym $mod+ctrl+Mod1+k exec xdotool mousemove_relative -p 0 100
# fast move mouse down
bindsym $mod+ctrl+Mod1+j exec xdotool mousemove_relative -p 180 100
# keyboard left click
bindsym $mod+Mod1+c exec xdotool click --clearmodifiers 1 
# keyboard right click
bindsym $mod+Mod1+ctrl+c exec xdotool click --clearmodifiers 3

# opens command list
bindsym $mod+Mod1+o exec cat $HOME/.config/i3/cmdlist.txt | rofi -dmenu -i -p "command dictionary"
# opens power menu
bindsym $mod+p exec $HOME/.config/i3/power.sh

# kill focused window
bindsym $mod+Shift+w kill

# start dmenu (a program launcher)
bindsym $mod+d exec rofi -show drun

# change focus
bindsym $mod+h focus left; exec --no-startup-id $HOME/.config/i3/centermouse.sh
bindsym $mod+j focus down; exec --no-startup-id $HOME/.config/i3/centermouse.sh
bindsym $mod+k focus up; exec --no-startup-id $HOME/.config/i3/centermouse.sh
bindsym $mod+l focus right; exec --no-startup-id $HOME/.config/i3/centermouse.sh

# move focused window left
bindsym $mod+Shift+h move left 40 px
# move focused window down
bindsym $mod+Shift+j move down 40 px
# move focused window up
bindsym $mod+Shift+k move up 40 px
# move focused window right
bindsym $mod+Shift+l move right 40 px

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle
# toggle tiling / floating
bindsym $mod+Shift+space floating toggle
# toggle sticky window
bindsym $mod+ctrl+space sticky toggle 
# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# We use variables to avoid repeating the names in multiple places.
set $ws1 "firefox"
set $ws2 "ai"
set $ws3 "games"
set $ws4 "cli"
set $ws5 "chatapps"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "bg apps"

# Automatically float and make Picture-in-Picture windows sticky
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [title="Picture-in-picture"] floating enable, sticky enable
for_window [window_role="PictureInPicture"] floating enable, sticky enable


for_window [title="netflix"] fullscreen enable
assign [class="netflix"] $ws2



# workspace default monitor
workspace $ws1 output DP-4
workspace $ws3 output DP-4
workspace $ws2 output DP-0
workspace $ws4 output DP-0
workspace $ws10 output DP-0
workspace $ws5 output DP-O

# workspace assignment for apps on start up
assign [class="obs"] $ws4
assign [class="discord"] $ws2
assign [class="steamwebhelper"] $ws3
assign [class="steam"] $ws3
assign [class="Noisetorch"] $ws10
assign [class="wootility"] $ws2
assign [class="vesktop"] $ws5
assign [class="Fluxer"] $ws5
assign [class="discord"] $ws5
assign [class="Minecraft* 26.2"] $ws3

# switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# reload the configuration file
# restart i3place (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
# bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do'Yes, exit i3' 'i3-msg exit'"
# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
	set $rs 100
        bindsym h resize shrink width $rs px
        bindsym j resize grow height $rs px
        bindsym k resize shrink height $rs px
        bindsym l resize grow width $rs px

   # resizing off of center 
# Resize width evenly (Grow)
bindsym $mod+Shift+l exec $HOME/.config/i3/centerresize.sh grow width 100

# Resize width evenly (Shrink)
bindsym $mod+Shift+h exec $HOME/.config/i3/centerresize.sh shrink width 100

# Resize height evenly (Grow)
bindsym $mod+Shift+k exec $HOME/.config/i3/centerresize.sh grow height 100

# Resize height evenly (Shrink)
bindsym $mod+Shift+j exec $HOME/.config/i3/centerresize.sh shrink height 100


               # back to normal: Enter or Escape or $mod+r

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}


bindsym $mod+r mode "resize"

# startup commands
exec_always picom --config $HOME/.config/picom/1picom.conf
exec_always $HOME/.config/polybar/launch.sh
exec_always xrandr --output DP-4 --left-of DP-0
exec_always mullvad connect
exec feh --bg-scale $HOME/.config/i3/backgrounds/felix.png
exec --no-startup-id xset s off -dpms
exec xmodmap $HOME/.config/i3/xmodmap
exec $HOME/pkg/fluxer.AppImage
exec $HOME/pkg/vencord.AppImage
exec_always xrandr --output DP-0 --auto --right-of DP-4
exec_always $HOME/pkg/autotiling-1.9.4/autotiling/main.py
exec kitty --tile ck1
exec i3-resurrect restore -w firefox
exec_always xmodmap $HOME/.config/i3/xmodmap
